# Servidor HTTP (Nitro/Node)
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=true

# SMTP: mantenha estes valores apenas na VPS, nunca em variaveis VITE_*.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp
SMTP_FROM="Trixus Site <nao-responda@trixus.com.br>"
CONTACT_TO=contato@trixus.com.br
